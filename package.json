{
  "name": "hangpay",
  "version": "0.5.10",
  "mcpName": "io.github.akshay/hangpay",
  "description": "The runtime security layer for AI agent commerce. Drop-in CLI + MCP server — blocks hallucinated purchases and keeps card credentials out of agent context. Card details are injected directly into the browser DOM via CDP; they never enter the agent's context window.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hangpay": "dist/cli-main.js",
    "hangpay-launch": "dist/cli.js",
    "hangpay-init-vault": "dist/cli-vault.js",
    "hangpay-unlock": "dist/cli-vault.js"
  },
  "scripts": {
    "build": "tsc",
    "build:native": "cd native && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai", "agent", "payment", "guardrail", "security", "cli", "command-line",
    "agent-tool", "payment-cli", "browser-agent", "mcp", "mcp-server",
    "model-context-protocol", "virtual-card", "cdp", "browser-automation", "checkout"
  ],
  "author": "Akshay <akshay@hangpay.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Armour007/hangpay.git"
  },
  "homepage": "https://github.com/Armour007/hangpay#readme",
  "bugs": {
    "url": "https://github.com/Armour007/hangpay/issues"
  },
  "engines": { "node": ">=18.0.0" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.0",
    "playwright-core": "^1.59.1",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "keytar": "^7.9.0",
    "openai": "^4.60.0",
    "stripe": "^17.0.0",
    "razorpay": "^2.9.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.89.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist/", "dashboard/", "native/hangpay-native.*.node", "README.md", "LICENSE"
  ]
}